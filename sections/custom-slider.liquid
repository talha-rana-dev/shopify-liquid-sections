{%- comment -%} sections/custom-slider.liquid {%- endcomment -%}

{%- style -%}
  .cs-{{ section.id }} {
    --cs-height: {{ section.settings.height }}px;
    --cs-height-mobile: {{ section.settings.height_mobile }}px;
    --cs-overlay: {{ section.settings.overlay_color }};
    --cs-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --cs-heading-size: {{ section.settings.heading_size }}px;
    --cs-heading-size-mobile: {{ section.settings.heading_size | times: 0.65 | round }}px;
    --cs-sub-size: {{ section.settings.subheading_size }}px;
    --cs-text-color: {{ section.settings.text_color }};
    --cs-shadow: {% if section.settings.text_shadow %}0 2px 12px rgba(0,0,0,{{ section.settings.shadow_strength | divided_by: 100.0 }}){% else %}none{% endif %};
    --cs-btn-bg: {{ section.settings.button_bg }};
    --cs-btn-text: {{ section.settings.button_text_color }};
    --cs-arrow-bg: {{ section.settings.arrow_bg }};
    --cs-arrow-color: {{ section.settings.arrow_color }};
    --cs-dot-color: {{ section.settings.dot_color }};
    --cs-pad-top: {{ section.settings.padding_top }}px;
    --cs-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cs-content-pad-y: {{ section.settings.content_padding_y }}px;
    --cs-content-pad-x: {{ section.settings.content_padding_x }}px;
    --cs-content-pad-x-mobile: {{ section.settings.content_padding_x_mobile }}px;
    --cs-align: {{ section.settings.text_align }};
    --cs-justify: {% if section.settings.text_align == 'left' %}flex-start{% elsif section.settings.text_align == 'right' %}flex-end{% else %}center{% endif %};
    padding-top: var(--cs-pad-top);
    padding-bottom: var(--cs-pad-bottom);
  }
  .cs-{{ section.id }} .cs-wrap { position: relative; overflow: hidden; width: 100%; }
  .cs-{{ section.id }} .cs-track { display: flex; transition: transform 0.6s ease; will-change: transform; }
  .cs-{{ section.id }} .cs-slide { position: relative; flex: 0 0 100%; min-height: var(--cs-height); display: flex; align-items: center; justify-content: var(--cs-justify); }
  .cs-{{ section.id }} .cs-media { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cs-{{ section.id }} .cs-media img,
  .cs-{{ section.id }} .cs-media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cs-{{ section.id }} .cs-overlay { position: absolute; inset: 0; background: var(--cs-overlay); opacity: var(--cs-overlay-opacity); }
  .cs-{{ section.id }} .cs-content { position: relative; z-index: 2; max-width: 720px; padding: var(--cs-content-pad-y) var(--cs-content-pad-x); text-align: var(--cs-align); color: var(--cs-text-color); }
  .cs-{{ section.id }} .cs-heading { margin: 0 0 12px; font-size: var(--cs-heading-size); line-height: 1.15; color: var(--cs-text-color); text-shadow: var(--cs-shadow); }
  .cs-{{ section.id }} .cs-sub { margin: 0 0 24px; font-size: var(--cs-sub-size); line-height: 1.5; color: var(--cs-text-color); text-shadow: var(--cs-shadow); }
  .cs-{{ section.id }} .cs-btn { display: inline-block; padding: 14px 32px; background: var(--cs-btn-bg); color: var(--cs-btn-text); text-decoration: none; font-weight: 600; }
  .cs-{{ section.id }} .cs-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--cs-arrow-bg); color: var(--cs-arrow-color); font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .cs-{{ section.id }} .cs-prev { left: 16px; }
  .cs-{{ section.id }} .cs-next { right: 16px; }
  .cs-{{ section.id }} .cs-dots { position: absolute; bottom: 16px; left: 0; right: 0; display: flex; justify-content: center; gap: 8px; z-index: 5; }
  .cs-{{ section.id }} .cs-dot { width: 10px; height: 10px; border-radius: 50%; border: 0; padding: 0; background: var(--cs-dot-color); opacity: 0.4; cursor: pointer; }
  .cs-{{ section.id }} .cs-dot.is-active { opacity: 1; }
  @media (max-width: 749px) {
    .cs-{{ section.id }} .cs-slide { min-height: var(--cs-height-mobile); }
    .cs-{{ section.id }} .cs-heading { font-size: var(--cs-heading-size-mobile); }
    .cs-{{ section.id }} .cs-content { padding: var(--cs-content-pad-y) var(--cs-content-pad-x-mobile); }
    .cs-{{ section.id }} .cs-arrow { width: 36px; height: 36px; font-size: 16px; }
  }
{%- endstyle -%}

<div
  class="cs-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed }}"
>
  <div class="cs-wrap">
    <div class="cs-track">
      {%- for block in section.blocks -%}
        <div class="cs-slide" {{ block.shopify_attributes }}>
          <div class="cs-media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: block.settings.heading }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="cs-overlay"></div>
          <div class="cs-content">
            {%- if block.settings.heading != blank -%}
              <h2 class="cs-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <p class="cs-sub">{{ block.settings.subheading }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a class="cs-btn" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
      <button type="button" class="cs-arrow cs-prev" aria-label="Previous slide">&#10094;</button>
      <button type="button" class="cs-arrow cs-next" aria-label="Next slide">&#10095;</button>
    {%- endif -%}

    {%- if section.settings.show_dots and section.blocks.size > 1 -%}
      <div class="cs-dots">
        {%- for block in section.blocks -%}
          <button type="button" class="cs-dot" aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;
    var track = root.querySelector('.cs-track');
    var slides = root.querySelectorAll('.cs-slide');
    var dots = root.querySelectorAll('.cs-dot');
    var prev = root.querySelector('.cs-prev');
    var next = root.querySelector('.cs-next');
    var total = slides.length;
    var index = 0;
    var timer = null;
    var autoplay = root.getAttribute('data-autoplay') === 'true';
    var speed = parseInt(root.getAttribute('data-speed'), 10) * 1000;
    var startX = 0;

    function go(i) {
      index = (i + total) % total;
      track.style.transform = 'translateX(-' + index * 100 + '%)';
      dots.forEach(function (d, n) { d.classList.toggle('is-active', n === index); });
    }
    function start() {
      if (!autoplay || total < 2) return;
      stop();
      timer = setInterval(function () { go(index + 1); }, speed);
    }
    function stop() { if (timer) clearInterval(timer); }

    if (prev) prev.addEventListener('click', function () { go(index - 1); start(); });
    if (next) next.addEventListener('click', function () { go(index + 1); start(); });
    dots.forEach(function (d, n) { d.addEventListener('click', function () { go(n); start(); }); });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; stop(); }, { passive: true });
    root.addEventListener('touchend', function (e) {
      var diff = e.changedTouches[0].clientX - startX;
      if (Math.abs(diff) > 50) go(diff < 0 ? index + 1 : index - 1);
      start();
    });

    document.addEventListener('shopify:block:select', function (e) {
      if (!root.contains(e.target)) return;
      stop();
      go(Array.prototype.indexOf.call(slides, e.target));
    });
    document.addEventListener('shopify:block:deselect', function (e) { if (root.contains(e.target)) start(); });

    go(0);
    start();
  })();
</script>

{% schema %}
{
  "name": "Custom Slider",
  "tag": "section",
  "class": "custom-slider",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "height", "label": "Slide height (desktop)", "min": 300, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "height_mobile", "label": "Slide height (mobile)", "min": 240, "max": 700, "step": 20, "unit": "px", "default": 420 },
    { "type": "select", "id": "text_align", "label": "Content alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ]},
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "content_padding_y", "label": "Content padding top/bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "content_padding_x", "label": "Content padding left/right (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "content_padding_x_mobile", "label": "Content padding left/right (mobile)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },

    { "type": "header", "content": "Autoplay" },
    { "type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": true },
    { "type": "range", "id": "speed", "label": "Slide speed", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5 },

    { "type": "header", "content": "Text" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "checkbox", "id": "text_shadow", "label": "Enable text shadow", "default": true },
    { "type": "range", "id": "shadow_strength", "label": "Text shadow strength", "min": 10, "max": 90, "step": 5, "unit": "%", "default": 45 },

    { "type": "header", "content": "Overlay" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 30 },

    { "type": "header", "content": "Button" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#e63946" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },

    { "type": "header", "content": "Arrows and dots" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "color", "id": "arrow_bg", "label": "Arrow background", "default": "#ffffff" },
    { "type": "color", "id": "arrow_color", "label": "Arrow icon color", "default": "#000000" },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": true },
    { "type": "color", "id": "dot_color", "label": "Dot color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Slide heading" },
        { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Slide subheading text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Custom Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
